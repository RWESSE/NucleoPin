{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NucleoPin",
  "version": "1.0.3",
  "identifier": "za.nucleopin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NucleoPin",
        "width": 1440,
        "height": 900,
        "minWidth": 1152,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "NucleoPin"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMDYyOUE3Qjc3QkExMkUKUldRdW9YdTNweWtHSTRQelpwcnJCWjYzMWZ4UllISEQ5R1ZsUWxWMUMyVjFvcFk5N282SWNCY1IK",
      "endpoints": [
        "https://github.com/RWESSE/NucleoPin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
